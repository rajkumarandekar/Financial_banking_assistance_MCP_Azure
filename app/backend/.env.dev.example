# Azure OpenAI Settings
AZURE_OPENAI_ENDPOINT=your-azureopenai-endpoint
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4.1

# Azure services (if needed)
AZURE_DOCUMENT_INTELLIGENCE_SERVICE=your-doc-intel-service
AZURE_STORAGE_ACCOUNT=your-storage-account

# Azure Cosmos DB for NoSQL (ChatKit metadata store)
# Leave empty to use local SQLite fallback
AZURE_COSMOSDB_ENDPOINT=
AZURE_COSMOSDB_DATABASE=chatkit

#Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string
# MCP Servers (if running)
ACCOUNT_MCP_URL=http://localhost:8070
TRANSACTION_MCP_URL=http://localhost:8071/mcp
PAYMENT_MCP_URL=http://localhost:8072

# Customer service (GraphQL, not MCP) - used for real customer_id/role
# resolution during auth. Leave empty to fall back to demo_customer_map.py.
CUSTOMER_SERVICE_URL=http://localhost:8073
# Customer service MCP endpoint - used by CustomerAgent (separate from the
# GraphQL URL above, same service, different API surface).
CUSTOMER_MCP_URL=http://localhost:8073

# New domain services (MCP)
LOAN_MCP_URL=http://localhost:8074
CREDIT_MCP_URL=http://localhost:8075
DOCUMENT_MCP_URL=http://localhost:8076
COMMUNICATION_MCP_URL=http://localhost:8077

#Agent types - options: azure_chat, foundry_v2
AGENTS_TYPE=azure_chat

# End-user authentication (Entra ID / Azure AD).
# Leave AUTH_ENABLED=false (default) until an app registration is provisioned -
# see docs/entra-app-registration-setup.md. The app works fully with the mock
# user profile while this is disabled.
AUTH_ENABLED=false
AZURE_TENANT_ID=
AZURE_AD_BACKEND_CLIENT_ID=