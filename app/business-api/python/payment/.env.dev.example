# Same Postgres server as the other services, different schema (payment_schema).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bankingassistant

# Needed for MCP tool ownership checks (verifies accountId belongs to the caller).
ACCOUNT_SERVICE_URL=http://localhost:8070

# Needed to record payments as transactions (replaces the old TRANSACTIONS_API_SERVER_URL REST call).
TRANSACTION_SERVICE_URL=http://localhost:8071

PROFILE=dev
